PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_manager_db
DB_USER=task_manager
DB_PASSWORD=change_me

REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# Optional SMTP settings. When omitted, confirmation messages are logged locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Task Manager <no-reply@taskmanager.local>
FRONTEND_URL=http://127.0.0.1:5173

# PostgreSQL TLS (enable for deployments that require encrypted DB connections)
DB_SSL=false
DB_SSL_CA_PATH=

# HTTPS server certificate paths (required in production)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
