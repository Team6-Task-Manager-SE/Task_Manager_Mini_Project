DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=task_manager
DB_USER=task_manager
DB_PASSWORD=replace-with-database-password
REDIS_URL=rediss://default:replace-with-redis-password@redis.example.internal:6379
JWT_SECRET=replace-with-a-long-random-secret
PUBLIC_ORIGIN=https://tasks.example.com
DB_SSL_CA_FILE=/absolute/path/to/postgres-ca.pem
